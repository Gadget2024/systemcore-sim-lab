{
  "name": "systemcore-sim",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A browser-based FRC drivetrain and Limelight simulator for learning the SystemCore programming model.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs",
    "test": "node --test tests/*.test.mjs",
    "robot": "node scripts/run-robot.mjs",
    "test:java": "node scripts/run-robot.mjs test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@msgpack/msgpack": "3.1.3",
    "ws": "8.22.0"
  }
}
